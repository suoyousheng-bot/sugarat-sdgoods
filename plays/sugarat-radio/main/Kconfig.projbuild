menu "Sugarat Radio"
config SUGARAT_RADIO_CURATED_URL
    string "HTTPS URL of the Sugarat US station JSON array"
    default ""
    help
        Empty disables the hosted list. Failure falls back to Radio Browser,
        then the bundled development list. No service is provisioned by firmware.
config SUGARAT_RADIO_BROWSER_URL
    string "Radio Browser HTTPS server"
    default "https://de1.api.radio-browser.info"
config SUGARAT_RADIO_DEFAULT_TIMEZONE
    string "POSIX timezone for nationwide mode"
    default "EST5EDT,M3.2.0/2,M11.1.0/2"
endmenu
