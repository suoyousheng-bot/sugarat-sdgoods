"<!doctype html>\n<html lang=\"en\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Sugarat</title>\n<style>\n:root{font:16px system-ui,sans-serif;--bg:#f7f2e7;--ink:#26382b;--muted:#5e685c;--surface:#e2e7da;--accent:#d4ef79;color:var(--ink);background:var(--bg);color-scheme:light}\n*{box-sizing:border-box}body{max-width:600px;margin:auto;padding:24px 24px 48px}header{position:relative;padding-top:56px}.brand{font-size:14px;color:var(--muted)}h1{font-size:28px;line-height:1.25;margin:8px 0 16px}p{line-height:1.6;color:var(--muted)}button,input,select{font:inherit;color:inherit}button{border:0;border-radius:24px;min-height:48px;padding:12px 16px;background:var(--surface);cursor:pointer}button:active{background:var(--accent)}button:disabled{opacity:.5;cursor:default}#language{position:absolute;right:0;top:0;min-width:104px}input:focus,select:focus,button:focus-visible{outline:2px solid var(--ink);outline-offset:4px}\n.preview{width:min(280px,100%);aspect-ratio:1;border-radius:50%;margin:24px auto 32px;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;padding:40px 24px;gap:16px;background:var(--surface)}.preview-line{display:block;width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}.preview strong{font-size:28px;line-height:1.2}.preview .meta{color:var(--muted)}.preview hr{width:50%;margin:0;border:0;border-top:1px solid var(--muted)}form{display:grid;gap:24px}label{display:grid;gap:8px;font-weight:600}input,select{min-height:48px;width:100%;border-radius:16px;border:1px solid var(--muted);padding:12px 16px;background:var(--bg)}.hint{font-size:14px;margin:0}#save{font-weight:600;background:var(--accent);min-height:56px}#status{min-height:64px;padding:16px 0;white-space:pre-line}#status.error{font-weight:600}#status.error::before{content:'!';display:inline-block;margin-right:8px}#connection-hint{overflow-wrap:anywhere}@media(max-width:340px){body{padding:16px}header{padding-top:56px}}\n</style>\n<header><button id=\"language\" type=\"button\" aria-label=\"English / 中文\">English</button><div class=\"brand\">Sugarat</div><h1 data-i18n=\"title\"></h1><p data-i18n=\"intro\"></p></header>\n<div class=\"preview\" id=\"preview\"><strong class=\"preview-line\" id=\"v-name\"></strong><span class=\"preview-line meta\" id=\"v-meta\"></span><hr><span class=\"preview-line\" id=\"v-contact\"></span><span class=\"preview-line\" id=\"v-link\"></span></div>\n<form id=\"form\" novalidate>\n<label><span data-i18n=\"name\"></span><input id=\"name\" autocomplete=\"nickname\" required data-placeholder=\"name_placeholder\"></label>\n<label><span data-i18n=\"company\"></span><input id=\"company\" autocomplete=\"organization\" data-placeholder=\"optional\"></label>\n<label><span data-i18n=\"role\"></span><input id=\"role\" autocomplete=\"organization-title\" data-placeholder=\"role_placeholder\"></label>\n<label><span data-i18n=\"contact_kind\"></span><select id=\"kind\"><option value=\"0\" data-i18n=\"email\"></option><option value=\"1\" data-i18n=\"phone\"></option><option value=\"2\" data-i18n=\"wechat\"></option></select></label>\n<label><span data-i18n=\"contact\"></span><input id=\"contact\" autocomplete=\"off\" data-placeholder=\"optional\"></label>\n<label><span data-i18n=\"link\"></span><input id=\"link\" inputmode=\"url\" autocomplete=\"url\" placeholder=\"https://example.org\"></label>\n<p class=\"hint\" data-i18n=\"privacy\"></p><button id=\"save\" type=\"submit\" disabled data-i18n=\"save\"></button>\n</form>\n<div id=\"status\" role=\"status\" aria-live=\"polite\"></div><p class=\"hint\" id=\"connection-hint\" data-i18n=\"connection_hint\"></p>\n<script>\nconst copy={\n zh:{title:'编辑我的名片',intro:'资料保存在这台 Sugarat 设备，用于屏幕展示、名片码和设备交换。',name:'昵称 / 姓名',company:'公司 / 组织',role:'身份 / 职业',contact_kind:'联系方式类型',contact:'联系方式',link:'个人链接',email:'邮箱',phone:'电话',wechat:'微信',name_placeholder:'你希望大家如何称呼你',role_placeholder:'例如：硬件开发者',optional:'可不填写',privacy:'这些资料会公开展示和交换，请只填写愿意分享的内容。设备长字段自动滚动，网页预览使用省略号；名片码和交换保留完整资料。微信号按文字分享。',save:'保存到设备',preview:'名片内容预览',empty_name:'你的昵称',empty_meta:'身份 · 公司',not_set:'未填写',web:'主页',connection_hint:'在手机 Wi-Fi 设置中连接设备热点。若未自动打开页面，请扫描设备上的页面码，或在浏览器输入 http://192.168.4.1。退出编辑或到期后热点关闭。',connecting:'正在连接设备…',connected:'已连接，可以编辑。',submitting:'正在提交，等待设备确认保存…',saved:'已保存到设备，名片已更新。',missing_token:'缺少编辑授权。请连接设备热点后打开 http://192.168.4.1，或扫描设备上的页面码。',required_name:'请填写昵称 / 姓名。',invalid_url:'个人链接请填写完整的 http:// 或 https:// 地址。',field_too_long:'「{field}」过长，请缩短后保存。',save_changed:'保存记录已变化，请重新连接读取设备上的名片。',unauthorized:'编辑授权已失效。请连接热点后重新打开 http://192.168.4.1。',too_large:'名片内容过长，请缩短后保存。',invalid:'请检查字段长度、联系方式和网址。',busy:'上一条保存仍在处理，请稍后重试。',timeout:'连接超时，请保持热点连接并重新读取名片确认结果。',not_found:'设备接口不可用，请重新打开编辑页。',read_failed:'名片读取失败，请重新连接设备。',save_unconfirmed:'设备未能确认保存，请查看设备提示，重新连接后读取名片。',network_error:'连接中断，保存结果未确认。请保持热点连接，重新打开编辑页读取名片。',unknown:'设备暂时无法处理，请查看设备提示并重新连接。'},\n en:{title:'Edit your card',intro:'Your details stay on this Sugarat badge for its screen, card QR and badge exchange.',name:'Nickname / Name',company:'Company / Organization',role:'Role / Occupation',contact_kind:'Contact type',contact:'Contact',link:'Personal link',email:'Email',phone:'Phone',wechat:'WeChat',name_placeholder:'What should people call you?',role_placeholder:'For example: Hardware developer',optional:'Optional',privacy:'These details are public and shared during exchange. Only add information you want to share. Long fields scroll on the badge and use an ellipsis in this preview. QR and exchange retain all details. WeChat IDs are shared as text.',save:'Save to badge',preview:'Card content preview',empty_name:'Your name',empty_meta:'Role · Company',not_set:'Not set',web:'Web',connection_hint:'Join the badge hotspot in your phone Wi-Fi settings. If this page does not open automatically, scan the badge page QR or enter http://192.168.4.1 in a browser. The hotspot closes when editing ends or expires.',connecting:'Connecting to badge…',connected:'Connected. You can edit now.',submitting:'Submitting. Waiting for the badge to confirm…',saved:'Saved to badge. Your card is updated.',missing_token:'Editing authorization is missing. Join the hotspot and open http://192.168.4.1 or scan the badge page QR.',required_name:'Enter a nickname or name.',invalid_url:'Enter a complete http:// or https:// personal link.',field_too_long:'{field} is too long. Shorten it before saving.',save_changed:'The save record changed. Reconnect and read the card from the badge.',unauthorized:'Editing authorization expired. Join the hotspot and reopen http://192.168.4.1.',too_large:'Card content is too long. Shorten it before saving.',invalid:'Check field lengths, contact details and URL.',busy:'The previous save is still processing. Wait and retry.',timeout:'Connection timed out. Stay on the hotspot and reload the card to check the result.',not_found:'This badge API is unavailable. Reopen the editor.',read_failed:'Could not read the card. Reconnect to the badge.',save_unconfirmed:'The badge could not confirm saving. Check its notice, reconnect and read the card.',network_error:'Connection lost. Saving is unconfirmed. Stay on the hotspot and reopen the editor to read the card.',unknown:'The badge could not process this request. Check its notice and reconnect.'}\n};\nconst fields=['name','company','role','contact','link'],limits={name:48,company:64,role:64,contact:96,link:160};\nconst el=id=>document.getElementById(id),token=location.hash.slice(1),requested=new URLSearchParams(location.search).get('lang');\nlet language=['zh','en'].includes(requested)?requested:'en';\nlet busy=false,authorized=false,statusKey='connecting',statusError=false,statusField='';\nconst t=key=>copy[language][key]||copy[language].unknown;\nclass EditorError extends Error{constructor(code){super(code);this.code=code}}\nfunction renderStatus(){el('status').textContent=t(statusKey).replace('{field}',t(statusField));el('status').classList.toggle('error',statusError)}\nfunction status(key,error=false,field=''){statusKey=key;statusError=error;statusField=field;renderStatus()}\nfunction showError(error){const key=error instanceof EditorError?error.code:'unknown';if(key==='unauthorized'){authorized=false;el('save').disabled=true}status(key,true)}\nfunction profile(){return Object.fromEntries([...fields.map(key=>[key,el(key).value.trim()]),['kind',Number(el('kind').value)]])}\nfunction preview(){const p=profile();el('v-name').textContent=p.name||t('empty_name');el('v-meta').textContent=[p.role,p.company].filter(Boolean).join(' · ')||t('empty_meta');el('v-contact').textContent=t(['email','phone','wechat'][p.kind])+' · '+(p.contact||t('not_set'));el('v-link').textContent=t('web')+' · '+(p.link.replace(/^https?:\\/\\//,'')||t('not_set'))}\nfunction renderLanguage(){document.documentElement.lang=language==='zh'?'zh-CN':'en';document.title='Sugarat · '+t('title');for(const node of document.querySelectorAll('[data-i18n]'))node.textContent=t(node.dataset.i18n);for(const node of document.querySelectorAll('[data-placeholder]'))node.placeholder=t(node.dataset.placeholder);el('preview').setAttribute('aria-label',t('preview'));el('language').textContent=language==='zh'?'English':'中文';preview();renderStatus()}\nasync function request(path,options={}){\n let response,result;try{response=await fetch(path,{...options,cache:'no-store',headers:{Authorization:'Bearer '+token,...options.headers}});result=await response.json()}catch(error){throw new EditorError('network_error')}\n if(!response.ok)throw new EditorError(result.error||'unknown');return result;\n}\nasync function load(){\n if(!/^[a-f0-9]{32}$/.test(token)){status('missing_token',true);return}\n try{const p=await request('/api/profile');for(const key of fields)el(key).value=p[key]||'';el('kind').value=String(p.kind);authorized=true;el('save').disabled=false;preview();status('connected')}\n catch(error){showError(error)}\n}\nfor(const key of fields)el(key).addEventListener('input',preview);el('kind').addEventListener('change',preview);\nel('language').addEventListener('click',()=>{language=language==='zh'?'en':'zh';const url=new URL(location.href);url.searchParams.set('lang',language);history.replaceState(null,'',url);renderLanguage()});\nel('form').addEventListener('submit',async event=>{\n event.preventDefault();if(busy||!authorized)return;const p=profile();\n if(!p.name){status('required_name',true);return}\n for(const key of fields)if(new TextEncoder().encode(p[key]).length>limits[key]){status('field_too_long',true,key);return}\n if(p.link&&!/^https?:\\/\\/\\S+$/.test(p.link)){status('invalid_url',true);return}\n busy=true;el('save').disabled=true;status('submitting');\n try{\n  const pending=await request('/api/profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});\n  const deadline=Date.now()+15000;let saved=false;\n  while(Date.now()<deadline){\n   await new Promise(resolve=>setTimeout(resolve,300));const result=await request('/api/status');\n   if(result.id!==pending.id)throw new EditorError('save_changed');\n   if(result.state==='error')throw new EditorError(result.error||'save_unconfirmed');\n   if(result.state==='saved'){saved=true;break}\n  }\n  if(!saved)throw new EditorError('save_unconfirmed');status('saved');preview();\n }catch(error){showError(error)}finally{busy=false;el('save').disabled=!authorized}\n});\nwindow.addEventListener('hashchange',()=>location.reload());renderLanguage();load();\n</script>\n</html>\n"
